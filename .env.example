# Google Service Account JSON, as one-line JSON string
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}

LEADS_SPREADSHEET_ID=your-leads-spreadsheet-id
REPS_SPREADSHEET_ID=your-representatives-spreadsheet-id
# Optional tab names; defaults match the README
LEADS_SHEET_NAME=פניות
REPS_SHEET_NAME=נציגים

JOIN_FORM_URL=https://example.com/join
WEBSITE_URL=https://example.com
PAYMENT_BANK_DETAILS=פרטי חשבון הבנק יופיעו כאן
PAYMENT_BIT_DETAILS=פרטי Bit יופיעו כאן
ADMIN_PHONE=972501234567

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=your-access-token
PHONE_NUMBER_ID=your-phone-number-id
WABA_ID=your-whatsapp-business-account-id
WHATSAPP_API_VERSION=v26.0
WEBHOOK_VERIFY_TOKEN=choose-a-random-verification-token
APP_SECRET=your-meta-app-secret
PORT=3000

# The template must be approved in Meta before production use
WHATSAPP_TEMPLATE_NAME=new_lead_notification
WHATSAPP_TEMPLATE_LANGUAGE=he
